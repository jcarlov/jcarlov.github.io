@unpublished{velezlebron2026sugarrush,
  title     = {Sugar Rush: The Effect of Foreign Direct Investment in Colonial Puerto Rico (1898-1952)},
  author    = {Vélez Lebrón, Jeancarlo},
  year      = {2026},
  note      = {Job Market Paper. Work in Progress},
  abstract  = {This paper studies how the gains from U.S. colonial sugar investment in Puerto Rico (1898--1950) were divided among the workers and landowners most directly exposed. The economics literature on colonial institutions tends to find positive aggregate effects of foreign investment in export agriculture, while the historical record of Caribbean plantation capitalism emphasizes a dispossessed peasantry and persistently depressed wages. I argue the two are reconcilable: aggregate gains can coexist with sharply unequal local outcomes when dominant firms exercise market power over local factor markets. Because cane is heavy and decays once cut, processing mills (\textit{centrales}) became the dominant local buyers of both labor and cane, and the intensity of competition varied across space with the number of accessible mills. I develop a spatial oligopsony model that formalizes this mechanism, and am assembling the data to test it: full-count censuses (1910--1950), archival land tax records, and a firm-level panel of mills and the transport network, using staggered mill entry and exit as variation in local market structure.},
  selected  = {true}
}

@unpublished{velezlebron2025schoolclosures,
  title     = {Spatial Consequences of School Closures},
  author    = {Vélez Lebrón, Jeancarlo and Moradi, Reza},
  year      = {2025},
  note      = {Work in Progress},
  abstract  = {This paper integrates schools into a Quantitative Spatial Model to provide a tractable framework for evaluating the welfare consequences of school closures. We use the fact that these class of models admits a sufficient statistics approach and extend to examine the impact of School Access on neighborhoods. This sufficient statistic can be used to summarize the spatial equilibrium effects of changes in school accessibility on housing prices and population. The framework can be taken to data using reduced-form regressions, and we illustrate this using Puerto Rico's large-scale school consolidation program, in which 44\% of public schools were closed between 2007 and 2019.},
  slides    = {school_closures_slides.pdf},
  selected  = {true}
}

@unpublished{bobonis2026management,
  title     = {Improving and Sustaining Management Practices in Public Schools: Evidence from Puerto Rico},
  author    = {Bobonis, Gustavo and González-Navarro, Marco and Scur, Daniela and Vélez Lebrón, Jeancarlo},
  year      = {2026},
  note      = {Work in Progress},
  abstract  = {We study whether a large-scale management training program for public school principals can improve school management quality and student achievement in Puerto Rico. In a randomized controlled trial covering approximately 845 public schools across the island, we evaluate the effects of an intensive professional development program providing training, workshops, and personalized coaching on key management practices. The staggered design allows us to estimate both short- and medium-run treatment effects, addressing whether management training impacts can be sustained over time.},
  jpal      = {https://www.povertyactionlab.org/blog/7-15-22/reflecting-research-during-times-uncertainty-recap-puerto-ricos-edugespro-graduation},
  fos       = {https://foslab.org/projects/edugespro/},
  selected  = {true}
}

@unpublished{velezlebron2026sugarrush,
  title     = {Sugar Rush: Foreign Investment in Export Agriculture and Generational Mobility},
  author    = {Vélez Lebrón, Jeancarlo},
  year      = {2026},
  note      = {Job Market Paper. Work in Progress},
  abstract  = {Foreign investment in plantation economies and export agriculture can raise local output and wages in the long run, but the contemporaneous effects on workers and families remain unexplored. Furthermore, the effects on human capital and occupational choices, the margins by which permanent structural change can happen, remain ambiguous. I study this question in colonial Puerto Rico, where preferential access to the US market drove a boom in sugar organized around large central mills (1898–1950). Using newly digitized and linked individual census microdata (1910–1950) and a panel of mill locations, output and ownership, I exploit variation in the timing and spatial reach of mill expansion. I estimate effects on the occupational choices of the exposed generation and on the schooling and intergenerational mobility of their children. I also examine the conditions under which the gains reach workers rather than mill owners and landowners.},
  selected  = {true}
}

@unpublished{velezlebron2025schoolclosures,
  title     = {The Effects of School Consolidation on Students and Teachers: Evidence from an Underperforming System},
  author    = {Bobonis, Gustavo J. and Moradi, Reza and Sotomayor, Orlando J. and Vélez Lebrón, Jeancarlo and Wagner, Jessica},
  year      = {2025},
  note      = {Work in Progress},
  abstract  = {In recent years, a number of states and school districts in the US have engaged in large scale school consolidation reforms driven by infrastructure underutilization and the objective of reallocating scarce resources across schools. We investigate the determinants of this type of school consolidations, their effects on student enrollment and achievement, as well as the consequences for teachers, using data from over 400 consolidations of public elementary and middle schools across Puerto Rico during the period 2010-18. We document that school closures were orthogonal to students' academic performance at baseline; the strongest predictors of school closure are low aggregate enrollment levels and small average class sizes. Using a matched event study design that controls for students' enrollment histories, we find that school closures led to a 2 percentage points decline in enrollment and no effects on students' achievement in mathematics or language standardized tests, on average. Moreover, students displaced from under-(over-)performing schools experience large achievement gains (losses) relative to their non-displaced peers. These positive effects coincide with accessing teachers with higher (lower) baseline value added, and are much larger in magnitude compared to estimates from higher-performance school districts. We find limited evidence of spillovers from student and teacher displacement on receiving schools. Altogether, the results indicate that cost-saving consolidations could be made while limiting harm to achievement when schools are closed in the vicinity of adequate alternatives.},
  pdf       = {school_closures_draft.pdf},
  selected  = {true}
}

@unpublished{bobonis2026management,
  title     = {Improving and Sustaining Management Practices in Public Schools: Evidence from Puerto Rico},
  author    = {Bobonis, Gustavo and González-Navarro, Marco and Scur, Daniela and Vélez Lebrón, Jeancarlo},
  year      = {2026},
  note      = {Work in Progress},
  abstract  = {School management practices are linked to student learning across the world, but it is not clear how governments can improve them at scale within rigid public education systems. We evaluate a government-run, randomized management training program for the principals in Puerto Rico, measuring management with four waves of the Development World Management Survey and following principals, teachers and students over a decade of administrative data. Before the program, Puerto Rico's schools look like public schools in middle-income countries: management is about one standard deviation below US public schools, and people management predicts school test scores and teacher value added. The program raised management and leadership scores by 0.21–0.32 standard deviations three years after it began, but the gains dissipate. We find no improvement in student test scores, and no changes in teacher retention or composition, suggesting the theory of change for school management is complex and multifaceted.},
  jpal      = {https://www.povertyactionlab.org/blog/7-15-22/reflecting-research-during-times-uncertainty-recap-puerto-ricos-edugespro-graduation},
  fos       = {https://foslab.org/projects/edugespro/},
  selected  = {true}
}
